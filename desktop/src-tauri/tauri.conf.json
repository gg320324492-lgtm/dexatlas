{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DexAtlas Studio",
  "version": "0.1.0",
  "identifier": "io.github.dexatlas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DexAtlas Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8618 http://127.0.0.1:8618; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
