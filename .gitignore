# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
.venv/
venv/

# DexAtlas runtime data
.dexatlas/
workspace/
*.db
*.sqlite
*.sqlite3

# Test + coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml

# Analysis output — never commit decompiled third-party code
out/
_decompile/
jadx-out/
apktool-out/
smali/
resources/
*.apk
*.aab
*.apks
*.dex
*.idsig
*.so
report.html

# The one exception: DexAtlas's own demo application, built from the smali sources in
# examples/demo-app/ and rebuildable with scripts/build-demo-apk.sh. It is first-party,
# contains no third-party code, and a stranger needs it to run an analysis after cloning.
# The rules above stay in force for every other APK and smali tree.
!examples/demo-app/
!examples/demo-app/demo.apk
!examples/demo-app/smali/
!examples/demo-app/smali/**

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
